# Copy this file to .env and add your own credentials.
# GraphGuard's AI investigation requires your own Google AI API key.
GOOGLE_API_KEY=your_google_api_key_here

# FalkorDB connection details for your own instance.
# Local Docker default: localhost:6379
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# Fill these in only when your FalkorDB instance requires authentication.
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# Set to true when your FalkorDB connection uses SSL/TLS.
FALKORDB_SSL=false
GRAPHGUARD_GRAPH_NAME=graphguard
