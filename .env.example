# Copy this file to .env and fill in credentials for your own environment.
# Local FalkorDB defaults work with: docker run -p 6379:6379 falkordb/falkordb
GOOGLE_API_KEY=your_google_api_key_here
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
GRAPHGUARD_GRAPH_NAME=graphguard
